# Isolated staging environment template.
# Copy values into a dedicated Render workspace or a local .env.staging.
# Never commit real secrets. Never reuse production secrets, buckets, or DSNs.
#
# Classification
#   Generated by Render: DATABASE_URL, DOCUFLOW_SECRET_KEY (generateValue),
#     DOCUFLOW_PUBLIC_API_URL, DOCUFLOW_PUBLIC_WEB_URL, DOCUFLOW_CORS_ORIGINS,
#     API_INTERNAL_URL (web).
#   Owner-supplied at Blueprint apply (sync: false): S3_BUCKET,
#     S3_ACCESS_KEY_ID, S3_SECRET_ACCESS_KEY, S3_ENDPOINT_URL.
#   Fixed by infra/render.staging.yaml: DOCUFLOW_ENV, JOB_BROKER, AI_PROVIDER,
#     EMAIL_BACKEND, CLEANUP_INTERVAL_SECONDS, COOKIE_SECURE, STORAGE_BACKEND,
#     S3_REGION, S3_FORCE_PATH_STYLE.
#   Never copy from production: DATABASE_URL, S3_*, DOCUFLOW_SECRET_KEY,
#     STRIPE_*, MIDTRANS_*, AI_API_KEY, SMTP_*.
#   Optional comparison-only names for preflight (never paste passwords):
#     PRODUCTION_S3_BUCKET, PRODUCTION_DATABASE_HOST, PRODUCTION_DATABASE_NAME,
#     PRODUCTION_SECRET_KEY, PRODUCTION_S3_ACCESS_KEY_ID.

# Fail-fast uses DOCUFLOW_ENV=production. Staging still needs PostgreSQL + S3.
DOCUFLOW_ENV=production
DOCUFLOW_SECRET_KEY=
# Unique 32+ characters. Prefer Render generateValue. Do not use production.

DATABASE_URL=
# Staging Postgres only. Print host and database name (not the password) before use.

JOB_BROKER=inline
# Redis is omitted from infra/render.staging.yaml. Leave REDIS_URL unset.
# Do not set JOB_BROKER=rq and do not add a paid worker for staging.

STORAGE_BACKEND=s3
S3_ENDPOINT_URL=
# Required for Cloudflare R2 and MinIO. AWS S3 may use the default endpoint.
# Do not assume a provider until the owner confirms it.
S3_REGION=auto
S3_BUCKET=
# Dedicated staging bucket. Do not use the production bucket or a folder prefix
# inside the production bucket. The application has no global object-key prefix.
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=true

AI_PROVIDER=mock
EMAIL_BACKEND=console
COOKIE_SECURE=true
CLEANUP_INTERVAL_SECONDS=0
DOCUFLOW_TRUSTED_HOSTS=.onrender.com

# Comparison-only names for scripts/staging_preflight.py (never paste passwords):
# PRODUCTION_S3_BUCKET=
# PRODUCTION_DATABASE_HOST=
# PRODUCTION_DATABASE_NAME=
# PRODUCTION_SECRET_KEY=
# PRODUCTION_S3_ACCESS_KEY_ID=

# Optional live provider test against a dedicated test bucket (not staging user data):
# TEST_S3_BUCKET=
# TEST_S3_ACCESS_KEY_ID=
# TEST_S3_SECRET_ACCESS_KEY=
# TEST_S3_ENDPOINT_URL=
# TEST_S3_REGION=auto

# Opt-in operator scripts. Unset = NOT EXECUTED (safe for CI).
# STAGING_PREFLIGHT=1
# STAGING_MIGRATE_VERIFY=1
# STAGING_DATABASE_CONFIRM=
# STAGING_MIGRATE=1
# STAGING_API_URL=
# STAGING_HOST_CONFIRM=
# Required for non-loopback smoke targets. Must equal the API hostname.
# STAGING_WEB_URL=
# STAGING_SMOKE_MUTATIONS=1
# Required before login/upload/job/download/delete against staging.
# STAGING_SMOKE_EMAIL=
# STAGING_SMOKE_PASSWORD=
# STAGING_SMOKE_REGISTER=1
# Registration also requires STAGING_SMOKE_MUTATIONS=1.
# STAGING_SMOKE_PDF=
# STAGING_SMOKE_SECOND_EMAIL=
# STAGING_SMOKE_SECOND_PASSWORD=
