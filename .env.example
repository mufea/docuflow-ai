# DocuFlow AI — environment template
# Copy to .env and fill in local values. Never commit real secrets.

# --- Application ---
DOCUFLOW_ENV=development
DOCUFLOW_SECRET_KEY=replace-with-a-long-random-string-at-least-32-chars
DOCUFLOW_API_HOST=0.0.0.0
DOCUFLOW_API_PORT=43124
DOCUFLOW_PUBLIC_API_URL=http://127.0.0.1:43124
DOCUFLOW_PUBLIC_WEB_URL=http://127.0.0.1:43123
DOCUFLOW_CORS_ORIGINS=http://127.0.0.1:43123,http://localhost:43123
DOCUFLOW_TRUSTED_HOSTS=127.0.0.1,localhost

# --- Database (PostgreSQL in production; SQLite allowed for local tests) ---
DATABASE_URL=postgresql+psycopg://docuflow:docuflow_dev@127.0.0.1:5432/docuflow

# --- Redis (job queue + rate limits). Optional in development when JOB_BROKER=inline ---
REDIS_URL=redis://127.0.0.1:6379/0
JOB_BROKER=inline
RQ_QUEUE_NAME=docuflow
WORKER_TIMEOUT_SECONDS=300
WORKER_CONCURRENCY=2

# --- Object storage ---
# local filesystem for development; s3 for Render/production
STORAGE_BACKEND=filesystem
STORAGE_LOCAL_PATH=./data/storage
# S3-compatible (AWS S3, Cloudflare R2, MinIO). Leave empty in local filesystem mode.
S3_ENDPOINT_URL=
S3_REGION=auto
S3_BUCKET=docuflow-documents
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=true
S3_SIGNED_URL_EXPIRES_SECONDS=600

# --- Limits ---
MAX_UPLOAD_BYTES=52428800
MAX_PAGES=400
MAX_IMAGES_PER_JOB=40
FILE_RETENTION_HOURS=24
RESULT_RETENTION_HOURS=48
TEMP_DIR=

# --- Auth / cookies ---
SESSION_COOKIE_NAME=df_session
CSRF_COOKIE_NAME=df_csrf
SESSION_TTL_SECONDS=1209600
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# --- Email (console adapter in development; SMTP in production) ---
EMAIL_BACKEND=console
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=DocuFlow AI <no-reply@localhost>
EMAIL_TOKEN_TTL_SECONDS=3600

# --- Credits / plans ---
DEFAULT_PLAN=free
ALLOW_NEGATIVE_CREDITS=false

# --- AI (never required for core PDF tools; keep keys server-side) ---
AI_PROVIDER=mock
AI_API_KEY=
AI_BASE_URL=
AI_MODEL=mock-docuflow
AI_TIMEOUT_SECONDS=30
AI_MAX_INPUT_CHARS=120000
OCR_ENABLED=true

# --- Payments (sandbox only unless explicitly authorized) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO=
STRIPE_PRICE_BUSINESS=
MIDTRANS_SERVER_KEY=
MIDTRANS_CLIENT_KEY=
MIDTRANS_IS_PRODUCTION=false
MIDTRANS_WEBHOOK_URL=

# --- Observability ---
LOG_LEVEL=INFO
LOG_JSON=false

# --- Next.js ---
NEXT_PUBLIC_API_BASE=/v1
API_INTERNAL_URL=http://127.0.0.1:43124
PORT=43123
